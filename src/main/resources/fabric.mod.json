{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "LayBalt QOL",
  "description": "Not Enough LayBalt. Quality-of-life helpers for Hypixel Skyblock (Auto Fishing, Auto Clicker, Auto Melody, Auto Experiment, Custom ESP, Vampire Slayer helper).",
  "authors": [
    "LayBalt",
    "Somikyy"
  ],
  "contact": {
    "homepage": "https://github.com/LayBalt/LayBalt-QOL",
    "sources": "https://github.com/LayBalt/LayBalt-QOL",
    "issues": "https://github.com/LayBalt/LayBalt-QOL/issues"
  },
  "license": "Unlicense",
  "icon": "assets/lbqmod/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.laybalt.Main"
    ],
    "modmenu": [
      "com.laybalt.ModMenuIntegration"
    ]
  },
  "accessWidener": "lbqmod.accesswidener",
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=25",
    "fabric-api": "*",
    "fabric-language-kotlin": ">=${fabric_kotlin_version}",
    "yet_another_config_lib_v3": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
